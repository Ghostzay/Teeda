# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by /settings to create technician accounts, and to
# pre-confirm salon owners while AUTH_AUTO_CONFIRM is on (auth admin API).
# NEVER expose this to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Draft mode: new salon owners are created already email-confirmed and signed
# straight in — no verification link. Requires SUPABASE_SERVICE_ROLE_KEY.
# Set to "false" before going live so real owners verify their email.
AUTH_AUTO_CONFIRM=true

# Optional, only for `npm run types:gen`
SUPABASE_PROJECT_ID=your-project-ref
